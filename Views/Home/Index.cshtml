@{
    ViewData["Title"] = "LogiTech - Dinamik İstanbul Ajanı";
    Layout = null;
}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; }
    #map { z-index: 10; cursor: crosshair; }
    .loader { border-top-color: #3b82f6; animation: spinner 1.5s linear infinite; }
    @@keyframes spinner { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .leaflet-popup-content-wrapper, .leaflet-popup-tip { background-color: #1e293b; color: white; border: 1px solid #334155; }
    
  
    .truck-marker {
        font-size: 28px;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5));
        transition: all 1.5s ease-in-out; 
        margin-top: -14px;
        margin-left: -14px;
        z-index: 999 !important;
    }
</style>

<div class="min-h-screen flex flex-col">
    <header class="bg-slate-800 border-b border-slate-700 p-4 shadow-md z-20 relative">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-600 p-2 rounded-lg shadow-lg">
                    <i data-lucide="cpu" class="text-white w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wide">LogiTech AI</h1>
                    <p class="text-xs text-slate-400">Rasyonel Ajan: Canlı İstanbul Simülasyonu</p>
                </div>
            </div>
            <button onclick="resetSelection()" class="text-sm bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg transition-colors border border-slate-600 shadow-sm">
                <i data-lucide="rotate-ccw" class="w-4 h-4 inline-block mr-1"></i> Sistemi Sıfırla
            </button>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto w-full p-6 grid grid-cols-1 lg:grid-cols-3 gap-6 relative z-10">
 
        <div class="lg:col-span-2 space-y-4">
           
            <div class="bg-slate-800/80 backdrop-blur-md rounded-2xl p-4 border border-slate-700 shadow-lg grid grid-cols-3 gap-4">
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-slate-700 rounded-lg text-emerald-400"><i data-lucide="clock"></i></div>
                    <div>
                        <p class="text-xs text-slate-400 font-semibold uppercase">Sistem Saati</p>
                        <p class="font-bold" id="uiTime">--:--</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3 border-l border-slate-700 pl-4">
                    <div class="p-2 bg-slate-700 rounded-lg text-blue-400"><i data-lucide="calendar"></i></div>
                    <div>
                        <p class="text-xs text-slate-400 font-semibold uppercase">Gün Tipi</p>
                        <p class="font-bold" id="uiDay">-----</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3 border-l border-slate-700 pl-4">
                    <div class="p-2 bg-slate-700 rounded-lg text-yellow-400"><i data-lucide="cloud-lightning"></i></div>
                    <div>
                        <p class="text-xs text-slate-400 font-semibold uppercase">Canlı Hava</p>
                        <p class="font-bold text-sm" id="uiWeather">Bekleniyor</p>
                    </div>
                </div>
            </div>

            <div class="bg-slate-800 rounded-2xl p-6 border border-slate-700 shadow-lg flex justify-between items-center">
                <div>
                    <h2 class="text-lg font-semibold mb-1">İnteraktif Rota Seçimi</h2>
                    <p class="text-sm text-blue-400 font-medium" id="instructionText">Haritadan bir <b>Başlangıç</b> noktası seçin.</p>
                </div>
                <button id="runAgentBtn" onclick="runAgent()" disabled class="bg-blue-600 disabled:bg-slate-700 disabled:text-slate-500 hover:bg-blue-500 text-white font-medium py-2.5 px-6 rounded-xl shadow-lg flex items-center space-x-2 transition-all">
                    <i data-lucide="play" class="w-4 h-4"></i>
                    <span>Ajanı Çalıştır</span>
                </button>
            </div>

            <div class="bg-slate-800 rounded-2xl p-2 border border-slate-700 shadow-lg relative overflow-hidden">
                <div id="map" class="h-[450px] w-full rounded-xl bg-slate-900"></div>
                <div id="loadingScreen" class="absolute inset-0 z-20 hidden bg-slate-900/90 backdrop-blur-sm rounded-xl flex flex-col items-center justify-center space-y-4">
                    <div class="loader ease-linear rounded-full border-4 border-t-4 border-blue-500 h-12 w-12 mb-4"></div>
                    <h2 class="text-white text-lg font-semibold">Araç Yola Çıkıyor...</h2>
                </div>
            </div>
        </div>

        <div class="space-y-6 pt-2">
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg">
                    <p class="text-xs text-slate-400 mb-1 font-semibold uppercase">Tahmini Maliyet</p>
                    <span class="text-3xl font-bold text-white" id="valCost">--</span>
                </div>
                <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-lg">
                    <p class="text-xs text-slate-400 mb-1 font-semibold uppercase">Durum</p>
                    <span class="text-lg font-bold text-slate-400" id="valStatus">Bekleniyor</span>
                </div>
            </div>

            <div class="bg-slate-900 rounded-2xl border border-slate-700 shadow-lg overflow-hidden flex flex-col h-[380px]">
                <div class="bg-slate-800 px-4 py-2 border-b border-slate-700 flex items-center space-x-2">
                    <i data-lucide="terminal" class="w-4 h-4 text-slate-400"></i>
                    <span class="text-xs font-semibold text-slate-300">SİSTEM LOGLARI</span>
                </div>
                <div class="p-4 overflow-y-auto flex-grow text-xs text-emerald-400 space-y-2 font-mono" id="terminalLogs">
                    <p class="text-slate-500">> Sistem hazır. Harita ve çevre verisi bekleniyor.</p>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    lucide.createIcons();

    
    const cityNodes = @Html.Raw(ViewBag.CityNodesJson);

    var map = L.map('map').setView([41.015, 28.979], 10);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);

    let selectedStart = null, selectedEnd = null, baseMarkers = [], routePolyline = null;
    let truckMarker = null; 
    let animationInterval = null;

    function log(message, color = "text-emerald-400") {
        const t = document.getElementById('terminalLogs');
        t.innerHTML += `<p class="${color}">> ${message}</p>`;
        t.scrollTop = t.scrollHeight;
    }

    function drawBaseStations() {
        baseMarkers.forEach(m => map.removeLayer(m));
        baseMarkers = [];
        Object.keys(cityNodes).forEach(key => {
            const node = cityNodes[key];
            let color = '#475569';
            if (key == selectedStart) color = '#22c55e';
            if (key == selectedEnd) color = '#ef4444';

            
            const marker = L.circleMarker([node.Lat, node.Lng], { radius: 8, fillColor: color, color: "#fff", weight: 2, fillOpacity: 0.9 }).addTo(map);
            marker.bindTooltip(node.Name, { permanent: false, direction: 'top' });
            marker.on('click', () => handleNodeClick(key, node.Name));
            baseMarkers.push(marker);
        });
    }

    function handleNodeClick(index, name) {
        if (selectedStart === null) {
            selectedStart = index;
            log(`Başlangıç Seçildi: ${name}`, "text-blue-400");
            document.getElementById('instructionText').innerHTML = "Şimdi <b>Bitiş</b> noktası seçin.";
        } else if (selectedEnd === null && index !== selectedStart) {
            selectedEnd = index;
            log(`Bitiş Seçildi: ${name}`, "text-blue-400");
            document.getElementById('instructionText').innerHTML = "Harika! <b>Ajanı Çalıştır</b> butonuna basın.";
            document.getElementById('runAgentBtn').disabled = false;
        }
        drawBaseStations();
    }

    function resetSelection() {
        selectedStart = null; selectedEnd = null;
        if(routePolyline) map.removeLayer(routePolyline);
        if(truckMarker) { map.removeLayer(truckMarker); truckMarker = null; }
        if(animationInterval) clearInterval(animationInterval);
        
        document.getElementById('instructionText').innerHTML = "Haritadan bir <b>Başlangıç</b> noktası seçin.";
        document.getElementById('runAgentBtn').disabled = true;
        document.getElementById('valCost').innerText = "--";
        document.getElementById('valStatus').innerText = "Bekleniyor";
        document.getElementById('valStatus').className = "text-lg font-bold text-slate-400";
        document.getElementById('uiTime').innerText = "--:--";
        document.getElementById('uiDay').innerText = "-----";
        document.getElementById('uiWeather').innerText = "Bekleniyor";
        
        log("Sistem sıfırlandı. Yeni rota bekleniyor.", "text-slate-500");
        drawBaseStations(); map.setView([41.015, 28.979], 10);
    }

   async function runAgent() {
        if (selectedStart === null || selectedEnd === null) return;
        document.getElementById('runAgentBtn').disabled = true;
        document.getElementById('loadingScreen').classList.remove('hidden');
        
        
        document.getElementById('terminalLogs').innerHTML = '';
        log("Sistem hazır. Harita ve çevre verisi bekleniyor.", "text-slate-500");
        log(`Başlangıç Seçildi: ${cityNodes[selectedStart].Name}`, "text-blue-400");
        log(`Bitiş Seçildi: ${cityNodes[selectedEnd].Name}`, "text-blue-400");
        log("Ajan rotayı hesaplıyor...", "text-slate-300");

        try {
            const response = await fetch(`/Home/TestAgent?start=${selectedStart}&end=${selectedEnd}`);
            const data = await response.json(); 

           
            if (data.durum === "Hata") {
                log(`HATA: ${data.aciklama}`, "text-red-500 font-bold");
                log("Sistem sıfırlandı. Yeni rota bekleniyor.", "text-slate-500");
                
              
                document.getElementById('loadingScreen').classList.add('hidden');
                document.getElementById('runAgentBtn').disabled = true;
                selectedStart = null; selectedEnd = null; 
                if(routePolyline) map.removeLayer(routePolyline);
                if(truckMarker) { map.removeLayer(truckMarker); truckMarker = null; }
                drawBaseStations(); 
                return; 
            }

          
            document.getElementById('uiTime').innerText = data.sistemSaati;
            document.getElementById('uiDay').innerText = data.gunTipi;
            document.getElementById('uiWeather').innerText = data.havaDurumu;

            log(`Canlı Veri Alındı: ${data.gunTipi} - ${data.sistemSaati} | Hava: ${data.havaDurumu}`, "text-yellow-400");
            log(`Rota Hesaplandı! Maliyet: ${data.toplamMaliyet.toFixed(2)}`);
            
            document.getElementById('loadingScreen').classList.add('hidden');
            document.getElementById('valCost').innerText = data.toplamMaliyet.toFixed(2);
            document.getElementById('valStatus').innerText = "Teslimatta";
            document.getElementById('valStatus').className = "text-lg font-bold text-blue-400";

            if(routePolyline) map.removeLayer(routePolyline);
            
            const latlngs = [];
            data.rotaIndeksleri.forEach((idx) => {
                latlngs.push([cityNodes[idx].Lat, cityNodes[idx].Lng]);
            });
            
            routePolyline = L.polyline(latlngs, { color: '#3b82f6', weight: 4, opacity: 0.5 }).addTo(map);
            map.fitBounds(routePolyline.getBounds(), { padding: [50, 50] });

            animateTruck(latlngs);
            
        } catch (error) {
            log("Bağlantı hatası veya veri okunamadı.", "text-red-500");
            document.getElementById('loadingScreen').classList.add('hidden');
            document.getElementById('runAgentBtn').disabled = false;
        }
    }

    function animateTruck(routeCoordinates) {
        if(truckMarker) map.removeLayer(truckMarker);
        if(animationInterval) clearInterval(animationInterval);

        const truckIcon = L.divIcon({
            html: '<div>🚚</div>',
            className: 'truck-marker',
            iconSize: [28, 28]
        });

        truckMarker = L.marker(routeCoordinates[0], {icon: truckIcon}).addTo(map);

        let currentStep = 1; 
        
        animationInterval = setInterval(() => {
            if(currentStep < routeCoordinates.length) {
                truckMarker.setLatLng(routeCoordinates[currentStep]);
                log(`Araç İlerliyor: Aşama ${currentStep}/${routeCoordinates.length-1}`);
                currentStep++;
            } else {
                clearInterval(animationInterval);
                log("Teslimat Başarıyla Tamamlandı!", "text-emerald-400 font-bold");
                document.getElementById('valStatus').innerText = "Tamamlandı";
                document.getElementById('valStatus').className = "text-lg font-bold text-emerald-400";
            }
        }, 1500); 
    }

 
    drawBaseStations();
</script>